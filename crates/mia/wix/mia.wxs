<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX source (msitools/wixl dialect) for the FerroGate Machine Identity Agent
  (MIA) Windows MSI.

  Built on Linux (no Windows host required) by scripts/build-msi-amd64.sh with
  msitools' wixl. The Version and BinDir preprocessor variables are supplied on
  the wixl command line (see that script).

  Scope of the MSI: install mia.exe under "Program Files\FerroGate\MIA" and
  register + start the mia Windows service. The service is declared natively via
  ServiceInstall/ServiceControl so Windows Installer sequences install/start on
  install and stop/remove on uninstall (wixl mis-sequences custom actions). The
  ServiceInstall mirrors exactly what `mia service install` registers (see
  ferro-winauth::service): service name "mia", LocalSystem, auto-start, binpath
  `"<exe>" service run`.

  The install directory is appended to the system PATH by the MiaPath
  component (Environment element, Part="last", System="yes"), so `mia` and
  `mia-tray-admin` resolve from any new shell; Windows Installer removes the
  entry again on uninstall. The executables carry the FerroGate icon as a
  Win32 resource (crates/ferro-winres, linked by each crate's build.rs), which
  is what Explorer, Task Manager and the service's process show.

  Host configuration: the MiaSecureConfig custom action runs the installed
  `mia.exe service secure-config` (deferred, as LocalSystem, before
  StartServices). It makes %ProgramData%\FerroGate administrator-only and
  creates the FerroGateClients and FerroGateStatus local groups (plus any the
  configuration names) when missing — the status pipe cannot start without its
  group. A failure aborts the installation. The groups are created empty and
  are kept on uninstall (an administrator may have added members). The service
  creates missing groups at every start too. Only the FileKey + ExeCommand
  form is used: wixl supports it (type 18), unlike the Directory + ExeCommand
  form the v0.20.4 draft used.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="FerroGate Machine Identity Agent"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="FerroGate contributors"
           UpgradeCode="6F9B1F2E-1C3A-4E84-9A2D-2B7E5C0A1D44">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="FerroGate Machine Identity Agent installer"
             Comments="https://github.com/ffquintella/FerroGate" />

    <!-- Icon shown in "Apps & features" / Add or Remove Programs. -->
    <Icon Id="FerroGateMia.ico" SourceFile="crates/mia-tray/dist/icons/ferrogate-mia.ico" />
    <Property Id="ARPPRODUCTICON" Value="FerroGateMia.ico" />

    <!-- Replace any previously installed version on upgrade. -->
    <Upgrade Id="6F9B1F2E-1C3A-4E84-9A2D-2B7E5C0A1D44">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      OnlyDetect="no" Property="OLDERVERSIONFOUND" />
    </Upgrade>

    <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="FerroGateDir" Name="FerroGate">
          <Directory Id="INSTALLDIR" Name="MIA" />
        </Directory>
      </Directory>
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MiaExe" Guid="2C8E0A11-94B6-4D7C-8B0E-7B0F4A9C2E01">
        <File Id="miaExe" Name="mia.exe" Source="$(var.BinDir)/mia.exe" KeyPath="yes" />

        <!-- Register the service exactly as `mia service install` does: name
             "mia", auto-start, LocalSystem, binpath `"<exe>" service run`. -->
        <ServiceInstall Id="MiaService"
                        Name="mia"
                        DisplayName="FerroGate Machine Identity Agent"
                        Description="Attests this host to CMIS and serves the local helper API for minting child tokens."
                        Type="ownProcess"
                        Start="auto"
                        ErrorControl="normal"
                        Account="LocalSystem"
                        Arguments="service run"
                        Vital="no" />
        <!-- Start on install; stop on install+uninstall; remove on uninstall.
             Windows Installer sequences these (StartServices / StopServices /
             DeleteServices) correctly around RemoveFiles. -->
        <ServiceControl Id="MiaServiceControl"
                        Name="mia"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="no" />
      </Component>

      <!-- Put the install directory on the system PATH. "set" + Part="last"
           appends the value to the existing one (written as "[~];value");
           Permanent="no" removes just that part again on uninstall. The value
           is "[FerroGateDir]MIA", not "[INSTALLDIR]": INSTALLDIR resolves with
           a trailing backslash, which Windows Installer would not recognise
           as the entry the Chocolatey package and the NSIS installer wrote
           ("...\FerroGate\MIA"), leaving PATH with the directory twice. (The
           MSI has no directory dialog; an INSTALLDIR override on the msiexec
           command line is not reflected here.) Own component, keyed on a
           registry value, so the PATH entry's lifetime is independent of the
           file's. -->
      <Component Id="MiaPath" Guid="8E4B6D2A-71C3-4F59-A0E8-3C9D5B1F7A62">
        <RegistryValue Root="HKLM"
                       Key="Software\FerroGate\MIA"
                       Name="PathEntry"
                       Type="string"
                       Value="[INSTALLDIR]"
                       KeyPath="yes" />
        <Environment Id="MiaPathEnv"
                     Name="PATH"
                     Value="[FerroGateDir]MIA"
                     Action="set"
                     Part="last"
                     System="yes"
                     Permanent="no" />
      </Component>
    </DirectoryRef>

    <!-- Configure the host with the installed mia.exe (see the header):
         administrator-only %ProgramData%\FerroGate and the local groups the
         pipe DACLs name. Deferred + Impersonate="no" runs it as LocalSystem;
         Return="check" aborts (and rolls back) the install on failure. It
         runs before StartServices so the service finds its groups. -->
    <CustomAction Id="MiaSecureConfig"
                  FileKey="miaExe"
                  ExeCommand="service secure-config"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <InstallExecuteSequence>
      <Custom Action="MiaSecureConfig" Before="StartServices">NOT REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>

    <!-- TRAY-BEGIN: the mia-tray desktop companion (feature F18).
         scripts/build-msi-amd64.sh strips this block (and the ComponentRef
         below) when mia-tray.exe was not built (MIA_TRAY=0, or its
         cross-compile failed), so the agent MSI never depends on it. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MiaTrayExe" Guid="5D1C7E3A-2B4F-4A8E-9C61-3F0B8E2D7A15">
        <File Id="miaTrayExe" Name="mia-tray.exe" Source="$(var.BinDir)/mia-tray.exe" KeyPath="yes" />
        <!-- Startup entry: start the (unprivileged) tray at every user's
             logon. Removed with the component on uninstall. -->
        <RegistryValue Root="HKLM"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="FerroGateMiaTray"
                       Type="string"
                       Value="&quot;[INSTALLDIR]mia-tray.exe&quot;" />
      </Component>
    </DirectoryRef>
    <!-- TRAY-END -->

    <!-- ADMIN-BEGIN: the administrator client mia-tray-admin.exe (feature
         F22), beside mia-tray.exe so the tray can offer it. No Startup entry,
         no service, no elevation manifest. scripts/build-msi-amd64.sh strips
         this block and the AdminClient feature when it was not built. -->
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MiaTrayAdminExe" Guid="19C014FD-3AD1-4194-AA7C-C387CC044D59">
        <File Id="miaTrayAdminExe" Name="mia-tray-admin.exe" Source="$(var.BinDir)/mia-tray-admin.exe" KeyPath="yes" />
      </Component>
    </DirectoryRef>
    <!-- ADMIN-END -->

    <Feature Id="Main" Title="FerroGate MIA" Level="1">
      <ComponentRef Id="MiaExe" />
      <ComponentRef Id="MiaPath" />
      <ComponentRef Id="MiaTrayExe" /><!-- TRAY-REF -->
    </Feature>

    <!-- ADMIN-FEATURE-BEGIN: "Admin client" is OFF by default (Level 2 is above
         the default INSTALLLEVEL 1). Turn it on with
         msiexec /i ... ADDLOCAL=Main,AdminClient, or with the Chocolatey
         package parameter /AdminClient. -->
    <Feature Id="AdminClient" Title="Admin client" Level="2"
             Description="FerroGate administrator client, for approvers on managed devices. Opened from the tray menu; runs as the signed-in user.">
      <ComponentRef Id="MiaTrayAdminExe" />
    </Feature>
    <!-- ADMIN-FEATURE-END -->
  </Product>
</Wix>
