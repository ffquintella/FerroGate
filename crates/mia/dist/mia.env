# FerroGate Machine Identity Agent (MIA) configuration.
#
# This file is read by the systemd unit as an EnvironmentFile. MIA is
# configured entirely through environment variables; see docs/mia.md and the
# crate documentation for the full list and semantics. Uncomment and edit the
# values you need, then `systemctl restart mia`.

# Tracing verbosity (tracing EnvFilter syntax). Default: info.
#RUST_LOG=info

# --- Helper API (feature F08) -------------------------------------------------
# The helper API is ON by default. Set this to 0 to switch it off (it overrides
# helper.enable in mia.toml).
#FERROGATE_HELPER_ENABLE=1

# Path to the local helper-API Unix socket. Unset => the default
# /run/ferrogate/mia.sock (mia-<env>.sock for mia-<env>.toml environments);
# systemd provisions /run/ferrogate. When the daemon serves every environment,
# this applies to the default (mia.toml) environment only.
#FERROGATE_HELPER_SOCKET=/run/ferrogate/mia.sock

# Which environment serves the well-known helper address /run/ferrogate/mia.sock.
# Unset => default_environment in /etc/ferrogate/environments.toml, else mia.toml.
# Naming an environment (it must have a mia-<env>.toml) moves its listener to
# mia.sock and moves mia.toml's to mia.default.sock. Blank => mia.toml, whatever
# environments.toml says. An invalid name stops the daemon (fail closed). Prefer
# environments.toml: `mia test` and `mia setup` read it, but not this file.
#FERROGATE_DEFAULT_ENVIRONMENT=prod

# Octal mode for the helper socket. Default: 660.
#FERROGATE_HELPER_SOCKET_MODE=660

# --- Allowlist ----------------------------------------------------------------
# Signed CBOR allowlist of vetted local callers. Unset => the default
# /etc/ferrogate/allowlist.cbor (allowlist-<env>.cbor for mia-<env>.toml
# environments). A missing, stale or non-verifying body => deny every caller
# (fail closed). Being process-wide, a value set here applies to every
# environment the daemon serves.
#FERROGATE_ALLOWLIST=/etc/ferrogate/allowlist.cbor

# Trusted CMIS enrollment public key used to verify the allowlist. No default:
# unset => every caller is denied (fail closed). Required whenever
# FERROGATE_ALLOWLIST (or allowlist.path) is set.
#FERROGATE_ALLOWLIST_KEY=/etc/ferrogate/allowlist.pub

# Maximum accepted allowlist age in seconds. Default: 86400.
#FERROGATE_ALLOWLIST_MAX_AGE_SECS=86400

# Fetch this host's signed allowlist from CMIS at startup (by EK-derived UUID)
# and write it to FERROGATE_ALLOWLIST (or its default) before loading. Needs FERROGATE_CMIS_ENDPOINT
# + FERROGATE_CMIS_SPKI_PIN and a successful attestation; non-fatal on failure.
# Default: false.
#FERROGATE_ALLOWLIST_FETCH=false

# --- Attestation --------------------------------------------------------------
# Override the IMA runtime-measurement log path.
#FERROGATE_IMA_LOG=/sys/kernel/security/integrity/ima/ascii_runtime_measurements
