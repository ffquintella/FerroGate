#!/bin/sh
set -eu

SERVICE_USER=_ferrogate
STATUS_GROUP=ferrogate-status

if ! getent group "$SERVICE_USER" >/dev/null 2>&1; then
    groupadd --system "$SERVICE_USER"
fi
if ! getent passwd "$SERVICE_USER" >/dev/null 2>&1; then
    nologin=/usr/sbin/nologin
    if [ ! -x "$nologin" ]; then
        nologin=/sbin/nologin
    fi
    useradd --system \
        --gid "$SERVICE_USER" \
        --home-dir /var/lib/ferrogate \
        --no-create-home \
        --shell "$nologin" \
        --comment "FerroGate MIA service account" \
        "$SERVICE_USER"
fi
if ! getent group "$STATUS_GROUP" >/dev/null 2>&1; then
    groupadd --system "$STATUS_GROUP"
fi
# Keep the service account enrolled for account-management tooling. The
# hardened daemon deliberately clears supplementary groups before it runs,
# so the file ACL below is what lets a live SIGHUP reload read the config.
usermod -aG "$STATUS_GROUP" -- "$SERVICE_USER"

# The daemon reads configuration as root at startup, then drops to the service
# account and clears supplementary groups. Grant that UID read-only access so a
# SIGHUP can re-read root-owned configuration without weakening its group mode.
for config_file in /etc/ferrogate/mia*.toml /etc/ferrogate/environments.toml; do
    [ -f "$config_file" ] && [ ! -L "$config_file" ] || continue
    if [ "$(stat -c %U "$config_file" 2>/dev/null || true)" = root ]; then
        setfacl --modify "user:$SERVICE_USER:r--" -- "$config_file"
    fi
done

if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules >/dev/null 2>&1 ||
        echo "ferrogate-mia: warning: could not reload udev rules" >&2
    udevadm trigger --action=change --subsystem-match=tpmrm >/dev/null 2>&1 ||
        echo "ferrogate-mia: warning: could not retrigger TPM resource-manager devices" >&2
fi

for tpm_device in /dev/tpmrm[0-9]*; do
    [ -c "$tpm_device" ] || continue
    if setfacl --modify "user:$SERVICE_USER:rw-" -- "$tpm_device"; then
        echo "ferrogate-mia: granted $SERVICE_USER access to $tpm_device"
    else
        echo "ferrogate-mia: warning: could not grant $SERVICE_USER access to $tpm_device" >&2
    fi
done

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    if [ "${1:-1}" -gt 1 ] && systemctl is-active --quiet mia.service; then
        systemctl try-restart mia.service >/dev/null 2>&1 || true
    fi
fi

exit 0
