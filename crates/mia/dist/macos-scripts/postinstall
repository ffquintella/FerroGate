#!/bin/sh
# postinstall for the FerroGate MIA macOS package.
#
# Creates the runtime/log directories the launchd daemon expects. The daemon is
# intentionally left UNLOADED — the operator must configure /etc/ferrogate/mia.env
# and then `sudo launchctl load -w /Library/LaunchDaemons/com.ferrogate.mia.plist`.
set -eu

install -d -m 0750 /var/run/ferrogate
install -d -m 0750 /var/log/ferrogate

# ── Status group (feature F18) ───────────────────────────────────────────────
# Members of `ferrogate-status` may read the agent's read-only status endpoint
# (mia-tray, `mia status`). dscl groups are not listed in /etc/group, so the
# daemon is handed the numeric gid via FERROGATE_STATUS_SOCKET_GID in its
# launchd plist. The person running the installer (the console user) is added;
# the membership applies from their next login.
STATUS_GROUP=ferrogate-status
DAEMON_PLIST=/Library/LaunchDaemons/com.ferrogate.mia.plist
TRAY_AGENT=/Library/LaunchAgents/com.ferrogate.mia-tray.plist
if ! dscl . -read "/Groups/$STATUS_GROUP" >/dev/null 2>&1; then
  gid=500
  while dscl . -list /Groups PrimaryGroupID | awk '{print $2}' | grep -qx "$gid"; do
    gid=$((gid + 1))
  done
  dscl . -create "/Groups/$STATUS_GROUP"
  dscl . -create "/Groups/$STATUS_GROUP" PrimaryGroupID "$gid"
  dscl . -create "/Groups/$STATUS_GROUP" RealName "FerroGate MIA status readers"
  dscl . -create "/Groups/$STATUS_GROUP" Password "*"
fi
STATUS_GID="$(dscl . -read "/Groups/$STATUS_GROUP" PrimaryGroupID | awk '{print $2}')"

# ── Config group ─────────────────────────────────────────────────────────────
# The TOML configs are 0640 and would otherwise be root:wheel, unreadable by
# the status-group members (`mia status`, mia-tray). Hand the directory and
# every existing mia*.toml to the group; BSD semantics make files created later
# in the directory (e.g. `mia setup --environment homolog` writing
# mia-homolog.toml) inherit the directory's group. The files stay 0640, so
# only root and group members can read them; the directory stays 0755.
CONFIG_DIR="/Library/Application Support/FerroGate"
if [ -d "$CONFIG_DIR" ] && [ -n "$STATUS_GID" ]; then
  chgrp "$STATUS_GID" "$CONFIG_DIR"
  for f in "$CONFIG_DIR"/mia*.toml; do
    [ -f "$f" ] || continue
    chgrp "$STATUS_GID" "$f"
    chmod 0640 "$f"
  done
fi

# ── State secrets ────────────────────────────────────────────────────────────
# The machine signing key, SVID seed and sealed X.509-SVID live in the config
# directory, which stays 0755. Up to 0.22.0 the daemon wrote host-key.bin with
# its umask, leaving it 0644, and on macOS any user can read the hardware
# fingerprint the key is sealed to. Make every one owner-only now, without
# waiting for the daemon (which does the same at start). Symlinks are skipped
# so the chmod never lands outside the directory.
if [ -d "$CONFIG_DIR" ]; then
  for f in host-key.bin svid-seed.bin x509-svid.sealed; do
    [ -f "$CONFIG_DIR/$f" ] && [ ! -L "$CONFIG_DIR/$f" ] || continue
    chmod 0600 "$CONFIG_DIR/$f"
  done
fi

# ── Helper socket directory ──────────────────────────────────────────────────
# The helper API listens in $CONFIG_DIR/run (mia.sock, mia-<env>.sock), which
# the daemon gives the config directory's group (ferrogate-status) unless
# helper.socket_gid says otherwise. A run/ created before the config directory
# was handed to the group (an older install) kept root:wheel, and so did the
# sockets bound in it. Repair that state now so status-group members can reach
# the helper API without waiting for a daemon restart (the daemon re-applies
# the group on every start). Only gid 0 (wheel) is changed: any other group was
# set on purpose (helper.socket_gid) and is left alone. Reaching the socket is
# not being trusted by it: the signed allowlist still decides who may mint.
RUN_DIR="$CONFIG_DIR/run"
if [ -d "$RUN_DIR" ] && [ ! -L "$RUN_DIR" ] && [ -n "$STATUS_GID" ]; then
  if [ "$(stat -f %g "$RUN_DIR")" = 0 ]; then
    chgrp -h "$STATUS_GID" "$RUN_DIR"
    chmod 0750 "$RUN_DIR"
  fi
  for s in "$RUN_DIR"/mia*.sock; do
    [ -S "$s" ] && [ ! -L "$s" ] || continue
    [ "$(stat -f %g "$s")" = 0 ] || continue
    chgrp -h "$STATUS_GID" "$s"
  done
fi

CONSOLE_USER="$(stat -f%Su /dev/console 2>/dev/null || true)"
case "$CONSOLE_USER" in
  ""|root|loginwindow) CONSOLE_USER="" ;;
  *) dseditgroup -o edit -a "$CONSOLE_USER" -t user "$STATUS_GROUP" 2>/dev/null || true ;;
esac
if [ -f "$DAEMON_PLIST" ] && [ -n "$STATUS_GID" ]; then
  /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:FERROGATE_STATUS_SOCKET_GID string $STATUS_GID" "$DAEMON_PLIST" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Set :EnvironmentVariables:FERROGATE_STATUS_SOCKET_GID $STATUS_GID" "$DAEMON_PLIST"
fi
# Start the tray (a per-user LaunchAgent) in the console user's session now;
# it starts by itself at every later login. On an upgrade the running tray is
# booted out first, so the new app bundle (not the replaced binary) runs.
if [ -f "$TRAY_AGENT" ] && [ -n "$CONSOLE_USER" ]; then
  CONSOLE_UID="$(id -u "$CONSOLE_USER" 2>/dev/null || true)"
  if [ -n "$CONSOLE_UID" ]; then
    launchctl bootout "gui/$CONSOLE_UID/com.ferrogate.mia-tray" 2>/dev/null || true
    launchctl bootstrap "gui/$CONSOLE_UID" "$TRAY_AGENT" 2>/dev/null || true
  fi
fi

echo "FerroGate MIA installed."
echo "  Status readers (mia-tray, mia status): group $STATUS_GROUP (gid $STATUS_GID)${CONSOLE_USER:+, including $CONSOLE_USER from their next login}."
echo "  1. Edit /etc/ferrogate/mia.env"
echo "  2. sudo launchctl load -w /Library/LaunchDaemons/com.ferrogate.mia.plist"

exit 0
