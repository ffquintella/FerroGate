#!/bin/sh
set -eu

SERVICE_USER=_ferrogate

remove_tpm_access() {
    # The packaged rule is gone before postrm runs. Reload first so no new
    # event can add the ACL back, then remove it from every live RM node.
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
    fi
    if ! command -v setfacl >/dev/null 2>&1 ||
       ! getent passwd "$SERVICE_USER" >/dev/null 2>&1; then
        return
    fi
    for tpm_device in /dev/tpmrm[0-9]*; do
        [ -c "$tpm_device" ] || continue
        setfacl --remove "user:$SERVICE_USER" -- "$tpm_device" 2>/dev/null || true
    done
}

# cargo-deb removes/reloads the packaged mia.service at this point.
#DEBHELPER#

case "${1:-}" in
    remove|purge)
        remove_tpm_access
        rm -f /etc/systemd/system/mia.service.d/10-ferrogate-groups.conf
        rmdir /etc/systemd/system/mia.service.d 2>/dev/null || true
        if [ -d /run/systemd/system ]; then
            systemctl --system daemon-reload >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
